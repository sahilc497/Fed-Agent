# Application Configuration
APP_NAME="Federated Agentic Mesh"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
API_V1_STR=/api/v1

# PostgreSQL Database Configuration (Port 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/federated_mesh_dev
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/federated_mesh_dev

# Security & Authentication
JWT_SECRET_KEY=b2c896503f8485292eb5f3c96644f1074e5033878b66858e8e78077d704ba41c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Ollama AI Model Configuration (Local qwen3:8b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANSWER_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Local Embeddings & Model Policy (Sentence Transformers)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
ALLOW_MODEL_DOWNLOADS=false

# Document Storage & Upload Controls
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# Human Approvals & Self-Approval Prevention
APPROVAL_EXPIRY_MINUTES=60
PREVENT_SELF_APPROVAL=true
