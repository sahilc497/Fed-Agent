# Application Configuration
APP_NAME="Federated Agentic Mesh"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
API_V1_STR=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/federated_mesh_dev
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/federated_mesh_dev

# Security & Authentication
# Generate a strong 32-byte secret for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_JWT_32_BYTES_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Ollama AI Model Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Exact local model identified and verified on host:
ANSWER_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Local Embeddings & Model Policy
# Options: local_hash (zero external download), ollama, sentence_transformers
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=local-deterministic-384
EMBEDDING_DIMENSION=384
ALLOW_MODEL_DOWNLOADS=false

# Document Storage & Upload Controls
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# Human Approvals & Self-Approval Prevention
APPROVAL_EXPIRY_MINUTES=60
PREVENT_SELF_APPROVAL=true
