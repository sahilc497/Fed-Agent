# ==============================================================================
# Federated Agentic Mesh — Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Configuration
APP_NAME="Federated Agentic Mesh"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
API_V1_STR=/api/v1

# Networking & Same-Wi-Fi LAN Access
LAN_MODE=false

# SQLite Database (Python Standard-Library sqlite3)
DATABASE_PATH=data/federated_mesh.db

# Security & Authentication
JWT_SECRET_KEY=b2c896503f8485292eb5f3c96644f1074e5033878b66858e8e78077d704ba41c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Shared Ollama AI Model (qwen3:8b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANSWER_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9

# Local Embeddings & Model Policy (Sentence Transformers)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
ALLOW_MODEL_DOWNLOADS=false

# Intent Router Model & Data Directories
ROUTER_MODEL_PATH=data/router/intent_router.joblib
DATA_DIR=data
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# Human Approvals & Policy Controls
APPROVAL_EXPIRY_MINUTES=60
PREVENT_SELF_APPROVAL=true
